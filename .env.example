# EcoSync AI environment template
# Copy this file to `.env` in the repo root:
#   PowerShell: copy .env.example .env
#   macOS/Linux: cp .env.example .env
#
# Never commit your real `.env` file. It may contain Gemini, Firebase, and Gmail secrets.


# ---------------------------------------------------------------------------
# Django backend
# ---------------------------------------------------------------------------
# Use a long random value in production. This demo fallback is only for local use.
DJANGO_SECRET_KEY=change-me

# 1 = development mode. Set to 0 in production.
DJANGO_DEBUG=1

# Comma-separated hostnames allowed by Django.
# Add your Cloud Run/backend domain in production.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Comma-separated frontend origins allowed to call the API.
# Add your deployed frontend domain in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# ---------------------------------------------------------------------------
# Storage mode
# ---------------------------------------------------------------------------
# 0 = use seeded in-memory demo data.
# 1 = use Firebase/Firestore persistence.
USE_FIRESTORE=0

# Recommended transport for this project. REST is more reliable in local Docker/Windows setups.
FIRESTORE_TRANSPORT=rest

# Local Python path to the Firebase Admin SDK service account JSON.
# Example Windows:
# FIREBASE_CREDENTIALS_FILE=d:\Hackathon 2026\ecosync-ai\ecosync-ai-xxxx-firebase-adminsdk.json
FIREBASE_CREDENTIALS_FILE=

# Docker path to the same Firebase Admin SDK JSON.
# docker-compose mounts the repo root at /workspace inside the backend container.
# Example:
# FIREBASE_CREDENTIALS_FILE_DOCKER=/workspace/ecosync-ai-xxxx-firebase-adminsdk.json
FIREBASE_CREDENTIALS_FILE_DOCKER=

# Alternative credential style for deployments where JSON files are not convenient.
# Leave blank if using FIREBASE_CREDENTIALS_FILE.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=


# ---------------------------------------------------------------------------
# Gemini AI
# ---------------------------------------------------------------------------
# Get a key from Google AI Studio.
# If blank, EcoSync still works using deterministic fallback explanations.
GEMINI_API_KEY=

# Keep this configurable because Gemini model availability can change by region/account.
GEMINI_MODEL=gemini-3.1-flash-lite

# 1 = cache AI/fallback explanations per startup+mentor when inputs/model/prompt are unchanged.
# 0 = always generate fresh explanations on each match run.
REMEMBER_LLM_RESPONSES=1


# ---------------------------------------------------------------------------
# Registration and user approval
# ---------------------------------------------------------------------------
# 1 = allow public users to submit registration applications.
# Admin approval is still required before users can log in.
ALLOW_PUBLIC_REGISTRATION=1

# Group assigned to newly registered users.
DEFAULT_REGISTERED_USER_GROUP=program_manager


# ---------------------------------------------------------------------------
# Gmail SMTP for registration status emails
# ---------------------------------------------------------------------------
# Used when admin changes a user profile status:
# pending -> approved, pending -> declined, approved -> pending, etc.
#
# Use a Gmail App Password, NOT your normal Gmail password:
# 1. Enable 2-Step Verification on the Gmail account.
# 2. Create an App Password for Mail.
# 3. Paste the 16-character app password below.
EMAIL_BACKEND=orchestrator.services.gmail_backend.CertifiEmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1

# 0 = normal secure TLS verification.
# 1 = local demo escape hatch for corporate/antivirus TLS interception.
# Do not use insecure TLS in production.
EMAIL_ALLOW_INSECURE_TLS=0

EMAIL_HOST_USER=your_gmail_address@gmail.com
EMAIL_HOST_PASSWORD=your_16_character_gmail_app_password
DEFAULT_FROM_EMAIL=EcoSync AI <your_gmail_address@gmail.com>
