## Copy this file to .env and fill in the values to enable Firestore
# Keep this file out of source control; it contains secrets in real deployments

# Enable Firestore (set to 1 to use Firestore, otherwise uses in-memory demo store)
USE_FIRESTORE=1

# Firebase project id (default set in settings.py)
FIREBASE_PROJECT_ID=ecosync-ai-ed846

# Service account values (fill from your Firebase service account JSON)
# For FIREBASE_PRIVATE_KEY, replace actual newlines with \n when pasting into this file.
FIREBASE_CLIENT_EMAIL=your-service-account@ecosync-ai-ed846.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Gemini (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
USE_FIRESTORE=0

# Optional real Firestore credentials. Leave USE_FIRESTORE=0 for demo seed data.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional Gemini key. Without this, backend uses explainable demo AI fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
