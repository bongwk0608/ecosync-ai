DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
USE_FIRESTORE=0

# Optional real Firestore credentials. Leave USE_FIRESTORE=0 for demo seed data.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional Gemini key. Without this, backend uses explainable demo AI fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
